generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// `id` is the Clerk user id directly — Clerk already owns identity, and every
// write path already has `userId` from `auth()`, so there's no separate
// internal id or profile cache to keep in sync.
model User {
  id        String   @id
  createdAt DateTime @default(now())
  threads   Thread[]
  votes     Vote[]
}

// `updatedAt` is what the sidebar orders by — "most recently used thread",
// not "most recently created". Prisma's `@updatedAt` only fires on a write to
// *this* row, and creating a child `Turn` isn't one, so `POST /api/turns`
// bumps it explicitly inside the same transaction that creates the turn.
model Thread {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  turns     Turn[]

  @@index([userId])
  @@index([userId, updatedAt])
}

// One prompt sent into a thread. Named `Turn`, not `Message`, because one
// prompt fans out into several models' answers at once — it's a round, not
// a single item.
model Turn {
  id        String        @id @default(cuid())
  threadId  String
  thread    Thread        @relation(fields: [threadId], references: [id])
  prompt    String
  createdAt DateTime      @default(now())
  answers   ModelAnswer[]
  vote      Vote?

  @@index([threadId])
}

enum AnswerStatus {
  STREAMING
  COMPLETE
  ERROR
}

// One model's answer within a turn. These mirror what `lib/model-stream.ts`
// computes per call; persisting them is what a leaderboard speed column would
// eventually aggregate.
//
// Feature #13 added `ttfo`, `textTokens` and `reasoningTokens` rather than
// changing what the three original columns mean. `ttft` has always been time
// to the first *visible* delta and still is; `outputTokens` has always been
// the provider's total with reasoning folded in and still is. Redefining
// either in place would have silently reinterpreted every row already on
// disk — the numbers would have looked fine and meant something else. Older
// rows simply have null in the new columns, which reads as "not measured"
// rather than as zero.
model ModelAnswer {
  id              String       @id @default(cuid())
  turnId          String
  turn            Turn         @relation(fields: [turnId], references: [id])
  model           String
  status          AnswerStatus @default(STREAMING)
  content         String       @default("")
  // Time to the first visible text delta.
  ttft            Float?
  // Time to the first delta of any kind, reasoning included. The comparable one.
  ttfo            Float?
  tokensPerSecond Float?
  // The provider's total output, reasoning included.
  outputTokens    Int?
  // The answer alone, and the thinking alone. Null when a provider does not
  // break the total down, which is different from it having reasoned zero.
  textTokens      Int?
  reasoningTokens Int?
  createdAt       DateTime     @default(now())
  wonVote         Vote?

  @@index([turnId])
}

// A vote needs two or more answered models on its turn — that rule is
// application code (the one insert path), not a database constraint,
// since Postgres can't express "count of sibling rows >= 2" declaratively
// without a trigger. `turnId` being unique is the one thing the database
// does guarantee on its own: no double-voting on a turn.
model Vote {
  id        String      @id @default(cuid())
  turnId    String      @unique
  turn      Turn        @relation(fields: [turnId], references: [id])
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  answerId  String      @unique
  answer    ModelAnswer @relation(fields: [answerId], references: [id])
  createdAt DateTime    @default(now())

  @@index([userId])
}
